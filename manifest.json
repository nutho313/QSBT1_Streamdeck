{
  "Name": "nutho313 QSBT1 ControlMapper",
  "Version": "0.3.0.0",
  "Author": "nutho313",
  "Actions": [
    {
      "Name": "Tune Dial",
      "UUID": "ch.nutho313.qsbt1.dial",
      "Icon": "images/action_adjust",
      "Tooltip": "1 dial = 1 tune. Rotate = adjust | Push = toggle ON/OFF | Touch = cycle parameter",
      "SupportedInMultiActions": false,
      "Controllers": ["Keypad", "Encoder"],
      "Encoder": {
        "layout": "$A0",
        "TriggerDescription": {
          "Rotate": "CCW = -step  |  CW = +step",
          "Push":   "Toggle tune ON / OFF",
          "Touch":  "Cycle selected parameter"
        }
      },
      "States": [
        { "Image": "images/action_adjust", "Title": " " }
      ],
      "PropertyInspectorPath": "pi/dial.html"
    },
    {
      "Name": "Tune Button",
      "UUID": "ch.nutho313.qsbt1.button",
      "Icon": "images/action_status",
      "Tooltip": "Short press = +step | Long press = -step | Double press = cycle parameter. Shows all tune values, auto-refresh every 3s.",
      "SupportedInMultiActions": false,
      "Controllers": ["Keypad"],
      "States": [
        { "Image": "images/action_status", "Title": " " }
      ],
      "PropertyInspectorPath": "pi/dial.html"
    }
  ],
  "Category": "nutho313 QSBT1",
  "CategoryIcon": "images/category",
  "CodePath": "nutho313.QSBT1_Streamdeck.exe",
  "Description": "Control the Qubic System QS-BT1 seat belt tensioner directly from your Stream Deck.",
  "Icon": "images/plugin_icon",
  "URL": "https://www.nutho313.ch",
  "SDKVersion": 2,
  "Software": { "MinimumVersion": "6.0" },
  "OS": [{ "Platform": "windows", "MinimumVersion": "10" }]
}
